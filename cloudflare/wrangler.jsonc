// GymMane on Cloudflare. NOTHING here creates resources by itself:
// the D1 database and R2 bucket must exist first (see README-CLOUDFLARE.md).
{
  "name": "gymmane-web",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Flutter web build + login page, assembled into ./dist by `npm run assemble`.
  // run_worker_first: every request passes the auth gate in src/index.js.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gymmane-db",
      "database_id": "REPLACE_WITH_ID_AFTER_APPROVED_CREATE",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "gymmane-media" }
  ],

  // Daily backup + cleanup (02:17 UTC).
  "triggers": { "crons": ["17 2 * * *"] }

  // Added only at the approved deploy step (creates one DNS record for gym.dirar.me):
  // "routes": [{ "pattern": "gym.dirar.me", "custom_domain": true }]
  //
  // Secret (never in this repo):  wrangler secret put BOOTSTRAP_TOKEN
}
