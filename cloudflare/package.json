{
  "name": "gymmane-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers backend (D1 + R2) for the GymMane web app",
  "scripts": {
    "test": "node --experimental-sqlite --no-warnings --test test/*.test.js",
    "assemble": "node scripts/assemble.mjs",
    "dev": "wrangler dev",
    "migrate:remote": "wrangler d1 migrations apply gymmane-db --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
